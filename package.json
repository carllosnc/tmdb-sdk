{
  "name": "@carlosnc/tmdb-sdk",
  "publishConfig": {
    "access": "public"
  },
  "version": "0.14.2",
  "description": "Zero-dependency, edge-ready TypeScript client for TMDB API v3/v4 with native fetch, auto-retries, full types, and Next.js / SvelteKit adapters.",
  "license": "MIT",
  "author": "carllosnc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carllosnc/tmdb-sdk.git"
  },
  "homepage": "https://github.com/carllosnc/tmdb-sdk#readme",
  "keywords": [
    "tmdb",
    "tmdb-api",
    "themoviedb",
    "api",
    "client",
    "typescript",
    "sdk",
    "zero-dependency",
    "fetch",
    "edge-ready",
    "nextjs",
    "sveltekit",
    "bun",
    "cloudflare-workers",
    "movies",
    "tv-shows",
    "llms-txt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./sveltekit": {
      "import": {
        "types": "./dist/adapters/sveltekit.d.ts",
        "default": "./dist/adapters/sveltekit.js"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test",
    "check": "tsc -p tsconfig.json && bun test",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  }
}
